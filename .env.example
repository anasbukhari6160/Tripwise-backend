# Placeholders only. Never commit a real .env file.
# NODE_ENV must be production on Railway. It cannot be inferred automatically:
# without it the session cookie is issued with SameSite=Lax and Secure=false,
# which browsers refuse to send on Vercel -> Railway requests.
NODE_ENV=production

# Supplied by Railway. Local fallback is 3000.
# PORT=3000

# Required. Keep the SSL parameters; do not add rejectUnauthorized overrides.
DATABASE_URL=postgresql://username:password@database.example.com/tripwise?sslmode=verify-full

# Required. Random, at least 32 characters, and stable across restarts.
# Changing it invalidates every existing session.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required. Exact frontend origin, HTTPS, no path, query, or fragment, and no
# trailing slash. This is the only origin allowed to send credentialed requests.
FRONTEND_URL=https://frontend.example.com

# Required. Must be the same Google Web Client ID as Vercel's
# VITE_GOOGLE_CLIENT_ID. The backend never reads VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional; defaults to resend. Production rejects console mode.
EMAIL_MODE=resend
RESEND_API_KEY=your-resend-api-key

# Canonical sender for every email. RESEND_FROM_EMAIL is not read.
EMAIL_FROM=TripWise <noreply@example.com>

# Required at startup.
STRIPE_SECRET_KEY=your-stripe-secret-key

# Required for checkout.
STRIPE_PRICE_ID=your-stripe-price-id

# Required for webhook signature verification.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Required for destination photos.
PEXELS_API_KEY=your-pexels-api-key

# Required for contact form delivery.
CONTACT_RECEIVER_EMAIL=support@example.com

# Required for AI responses.
GROQ_API_KEY=your-groq-api-key

# Optional; defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b

# Required for factual travel grounding. Without it the AI answers that
# information is unavailable.
EXA_API_KEY=your-exa-api-key